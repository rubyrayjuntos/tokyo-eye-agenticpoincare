# Agent coordinator container — lightweight, no heavy ML deps
# Used for: API serving, WebSocket viewport protocol, tool dispatch
#
# Build: docker build -f Dockerfile.agent -t tokyoeye-agent .
# Run:   docker compose up agent

FROM python:3.11-slim

WORKDIR /app

# Agent dependencies only (no torch, no rdkit)
COPY requirements-agent.txt .
RUN pip install --no-cache-dir -r requirements-agent.txt

# Copy agent + data layer + shared utilities + science interfaces (not the heavy models)
COPY agent/ /app/agent/
COPY data/ /app/data/
COPY shared/ /app/shared/
COPY science/dtie/__init__.py /app/science/dtie/__init__.py
COPY science/dtie/v5/__init__.py /app/science/dtie/v5/__init__.py
COPY science/dtie/v5/orchestrator/ /app/science/dtie/v5/orchestrator/
COPY science/dtie/v5/phase_adapter.py /app/science/dtie/v5/phase_adapter.py
COPY science/dtie/common/ /app/science/dtie/common/
COPY science/__init__.py /app/science/__init__.py

ENV PYTHONPATH=/app

# Run as non-root user
RUN useradd -m -r appuser
USER appuser

EXPOSE 8000
CMD ["uvicorn", "agent.coordinator.app:app", "--host", "0.0.0.0", "--port", "8000"]
