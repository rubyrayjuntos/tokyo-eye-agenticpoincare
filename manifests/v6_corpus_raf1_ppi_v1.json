{
  "version": "1.0",
  "description": "RAF1-centered PPI pathway corpus inspired by the RAF1 Poincaré STRING network dashboard. Biology-coherent transfer set (not Stage A fold diversity). Stage A per-fold GTPase train cap is waived so KRAS/NRAS/HRAS co-train by design. ARAF uses a sanitized chain-B-only PDB written from 9AXM mmCIF (no legacy .pdb deposit). CDC37 uses NMR ensemble 2NCA rewritten to model-1-only.",
  "source": "raf1_ppi_dashboard_inspiration",
  "max_sequence_identity_pct": null,
  "max_train_per_fold_id": null,
  "pathway_override": "pathway_raf1_ppi",
  "proteins": [
    {
      "pdb_id": "3OMV",
      "chain": "A",
      "gene": "RAF1",
      "role": "train",
      "disposition_rule": "pathway_raf1_ppi",
      "enabled": true,
      "stage0": true,
      "note": "RAF1 kinase domain (hub)"
    },
    {
      "pdb_id": "4OBE",
      "chain": "A",
      "gene": "KRAS",
      "role": "train",
      "disposition_rule": "pathway_raf1_ppi",
      "enabled": true,
      "stage0": true,
      "note": "KRAS WT GDP; shared anchor with feeler_expand"
    },
    {
      "pdb_id": "3CON",
      "chain": "A",
      "gene": "NRAS",
      "role": "train",
      "disposition_rule": "pathway_raf1_ppi",
      "enabled": true,
      "stage0": false,
      "note": "NRAS GTPase"
    },
    {
      "pdb_id": "4G0N",
      "chain": "A",
      "gene": "HRAS",
      "role": "train",
      "disposition_rule": "pathway_raf1_ppi",
      "enabled": true,
      "stage0": false,
      "note": "HRAS G-domain (chain A); ignore RAF1 RBD chain B"
    },
    {
      "pdb_id": "4MNE",
      "chain": "B",
