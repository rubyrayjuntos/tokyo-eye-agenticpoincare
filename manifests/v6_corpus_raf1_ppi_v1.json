      "chain": "A",
      "gene": "MAP2K1",
      "role": "train",
      "disposition_rule": "pathway_raf1_ppi",
      "enabled": true,
      "stage0": false,
      "note": "MEK1 kinase domain"
    },
    {
      "pdb_id": "7JV0",
      "chain": "A",
      "gene": "KSR1",
      "role": "train",
      "disposition_rule": "pathway_raf1_ppi",
      "enabled": true,
      "stage0": false,
