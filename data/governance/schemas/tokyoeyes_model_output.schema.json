{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokyoeyes.dev/schemas/v3/tokyoeyes_model_output.schema.json",
  "title": "Tokyo Eyes v3 Model Output",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "pdb_id",
    "model_version",
    "uncertainty",
    "routing",
    "cone"
  ],
  "properties": {
    "schema": {
      "const": "tokyoeyes.model_output"
    },
    "schema_version": {
      "type": "string"
    },
    "pdb_id": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "uncertainty": {
      "type": "object",
      "required": ["global_score"],
      "properties": {
        "global_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "per_residue": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label_seq_id", "score"],
            "properties": {
              "label_seq_id": { "type": "integer", "minimum": 1 },
              "score": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "routing": {
      "type": "object",
      "required": ["selected_expert", "depth"],
      "properties": {
        "selected_expert": { "type": "string" },
        "depth": { "type": "integer", "minimum": 0 },
        "candidate_experts": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "cone": {
      "type": "object",
      "required": ["angle_degrees", "confidence"],
      "properties": {
        "angle_degrees": { "type": "number", "minimum": 0.0, "maximum": 180.0 },
        "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "apex_atom_id": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
