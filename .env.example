# Local development database (matches docker-compose.yml)
DATABASE_URL=postgresql://tokyoeye:tokyoeye_dev_local@localhost:5432/tokyoeye_dev

# Override for tests (uses same local DB or a separate test DB)
TEST_DATABASE_URL=postgresql://tokyoeye:tokyoeye_dev_local@localhost:5432/tokyoeye_test

# Object storage (local dev uses filesystem)
OBJECT_STORAGE_PATH=./data/local_objects

# Optional: point to a checkpoint directory
CHECKPOINT_DIR=./checkpoints

# Geometric contract enforcement (see science/contracts/README.md)
# GEOMETRIC_ENFORCEMENT_LEVEL=warning
# GEOMETRIC_ENFORCEMENT_ERROR_JOBS=gnn_inference,source_leak_detection

# Pipeline audit persistence (see shared/audit/)
# AUDIT_PIPELINE_PERSIST=true
# AUDIT_PIPELINE_MIN_SEVERITY=warning
# AUDIT_RETENTION_DAYS=90

# Environment: dev | staging | prod
ENVIRONMENT=dev

# Provenance — enforce code_version + checkpoint_sha256 on governed writes
# Defaults: strict in prod/staging, relaxed in dev when unset
# PROVENANCE_STRICT=true
# CODE_VERSION=git-sha-from-ci

# Auth — JWT secret (REQUIRED in prod, optional in dev)
# JWT_SECRET=your-secret-here

# Auth — set to "false" to allow unauthenticated access (dev only)
REQUIRE_AUTH=false

# Agent — deny compute dispatch tools unless explicitly enabled (ingest scheduler owns compute)
ALLOW_AGENT_COMPUTE=false

# CORS — frontend origin (required in prod)
# FRONTEND_ORIGIN=https://your-app.example.com

# Rate limiting
CHAT_RATE_LIMIT_PER_MINUTE=20

# Session store limits
SESSION_MAX_SIZE=10000
SESSION_TTL_SECONDS=86400

# Frontend shell (visualizer/frontend)
# VITE_USE_LEGACY_SHELL=true  # opt into react-resizable-panels IdeShellLayout

# Logging
LOG_LEVEL=INFO

# Plot output directory (for matplotlib figures generated by the agent)
PLOT_OUTPUT_DIR=./data/local_objects/plots

# GNN interactive 3D viewer (NGL HTML after gnn_inference)
GNN_INTERACTIVE_HTML=true
GNN_VIEWER_OUTPUT_DIR=./data/local_objects/gnn_viewer

AWS_ID=rswan-generalIAM
AWS_PWD=28LoveSigns!
